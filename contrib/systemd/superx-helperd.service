[Unit]
Description=Super X Helper capability service
After=dbus.service
Requires=dbus.service

[Service]
Type=dbus
BusName=org.sonoran.SuperXHelper1
ExecStart=/usr/bin/superx-helperd
User=root
Group=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
TimeoutStartSec=15
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
