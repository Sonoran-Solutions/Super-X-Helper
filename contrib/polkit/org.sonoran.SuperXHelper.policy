<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Sonoran Solutions</vendor>
  <action id="org.sonoran.SuperXHelper.set-performance">
    <description>Change a qualified Super X performance setting</description>
    <message>Administrator authentication is required to change privileged Super X performance settings.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="org.sonoran.SuperXHelper.set-cooling">
    <description>Change a qualified Super X cooling setting</description>
    <message>Administrator authentication is required to change privileged Super X cooling settings.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
